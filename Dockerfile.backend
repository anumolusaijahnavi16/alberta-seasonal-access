# ==============================
# Stage 1: Build ASP.NET Core API
# ==============================
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /src

COPY backend/AlbertaAccess.Api.csproj backend/

RUN dotnet restore backend/AlbertaAccess.Api.csproj

COPY backend/ backend/

WORKDIR /src/backend

RUN dotnet publish AlbertaAccess.Api.csproj \
    -c Release \
    -o /app/publish \
    --no-restore


# ==============================
# Stage 2: Run ASP.NET Core API
# ==============================
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime

WORKDIR /app

COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production

EXPOSE 8080

ENTRYPOINT ["dotnet", "AlbertaAccess.Api.dll"]